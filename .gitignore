# =============================================================================
# Emon DSL Skeleton —— .gitignore
# =============================================================================
# 项目：Emon DSL — 面向 eBPF 可观测性的领域特定语言编译器
# 版本：0.2.0
# =============================================================================

# =============================================================================
# 1. Python
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.egg
.venv/
venv/
*.whl

# ---- 测试 & 代码质量 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
htmlcov/
coverage.xml
*.prof

# ---- Python 虚拟环境（其他常见位置）----
env/
.env/

# =============================================================================
# 2. ANTLR4 生成文件（grammar 目录）----
# =============================================================================
# 生成命令：antlr4 EmonLexer.g4 EmonParser.g4
# 编译命令：javac -cp antlr-*.jar *.java
emon-dsl/grammar/*.java
emon-dsl/grammar/*.class
emon-dsl/grammar/*.tokens
emon-dsl/grammar/*.interp
.antlr/

# =============================================================================
# 3. C/C++ 构建产物
# =============================================================================
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.o
*.obj
*.so
*.a
*.exe
*.out
*.dylib
*.dll

# ---- CMake 导出 & 外部依赖 ----
CMakeUserPresets.json
compile_commands.json
CTestTestfile.cmake
Testing/
_cmake_cache/
*.cmake.in

# ---- 链接时优化 / 预编译头 ----
*.gch
*.pch
*.lto

# =============================================================================
# 4. 编译器生成产物（Emon DSL 编译器输出）----
# =============================================================================
# 完整的编译链：.emon → .bpf.c → .bpf.o → .skel.h → _loader.c → 可执行工具
out/
output/
*.bpf.c
*_loader.c
*.bpf.o
*.skel.h
vmlinux.h

# 生成的可执行 monitor 工具（无扩展名，由 gcc 生成）
# 注意：仅在根目录和 out/ 中忽略，不影响 src/ 下的源文件

# 生成的 YAML manifest（注意：emon-dsl/manifest/tool_manifest.yaml 是模板，不能忽略）
# 仅忽略编译器运行时输出的 *.yaml
out/*.yaml
output/*.yaml
*.generated.yaml

# =============================================================================
# 5. 日志与运行时文件
# =============================================================================
*.log
*.log.*
*.tmp
*.temp
*.bak
*.orig

# ---- core dump ----
core
core.*
*.core

# =============================================================================
# 6. IDE / 编辑器
# =============================================================================
.idea/
.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-*

# ---- Vim 会话 ----
Session.vim
Sessionx.vim

# ---- Emacs ----
*~
\#*\#

# =============================================================================
# 7. 操作系统
# =============================================================================
.directory
.dirstamp
*.lnk

# ---- Linux 打包 ----
*.deb
*.rpm
*.snap

USEAGE.md