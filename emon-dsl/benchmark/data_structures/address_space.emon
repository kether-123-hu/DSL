// ============================================================
// Benchmark: data_structures - address_space
// Tests monitoring address space I/O operations
// ============================================================

tool address_space_ds {
    option interval = 5s;
}

observe syscall("read", "write", "fsync")
measure count, retval
{
    @address_space_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== address_space stats ===");
    print(@address_space_count);
}
