// ============================================================
// Benchmark: data_structures - bpf_prog
// Tests monitoring BPF program lifecycle
// ============================================================

tool bpf_prog_ds {
    option interval = 5s;
}

observe syscall("bpf", "close", "ioctl")
measure count, retval
{
    @bpf_prog_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== bpf_prog stats ===");
    print(@bpf_prog_count);
}
