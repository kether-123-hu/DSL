// ============================================================
// Benchmark: data_structures - cgroup
// Tests monitoring control group namespace operations
// ============================================================

tool cgroup_ds {
    option interval = 5s;
}

observe syscall("clone", "unshare", "setns")
measure count, retval
{
    @cgroup_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== cgroup stats ===");
    print(@cgroup_count);
}
