// ============================================================
// Benchmark: data_structures - dentry
// Tests monitoring dentry path operations
// ============================================================

tool dentry_ds {
    option interval = 5s;
}

observe syscall("open", "rename", "unlink")
measure count, retval
{
    @dentry_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== dentry stats ===");
    print(@dentry_count);
}
