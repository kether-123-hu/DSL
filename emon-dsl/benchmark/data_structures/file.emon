// ============================================================
// Benchmark: data_structures - file
// Tests monitoring file descriptor operations
// ============================================================

tool file_ds {
    option interval = 5s;
}

observe syscall("open", "read", "write")
measure count, retval
{
    @file_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== file stats ===");
    print(@file_count);
}
