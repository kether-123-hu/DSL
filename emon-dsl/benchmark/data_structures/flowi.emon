// ============================================================
// Benchmark: data_structures - flowi
// Tests monitoring flow key operations
// ============================================================

tool flowi_ds {
    option interval = 5s;
}

observe syscall("sendto", "setsockopt", "getpeername")
measure count, retval
{
    @flowi_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== flowi stats ===");
    print(@flowi_count);
}
