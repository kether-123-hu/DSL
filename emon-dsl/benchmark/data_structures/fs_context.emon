// ============================================================
// Benchmark: data_structures - fs_context
// Tests monitoring filesystem context operations
// ============================================================

tool fs_context_ds {
    option interval = 5s;
}

observe syscall("open", "mount", "umount2")
measure count, retval
{
    @fs_context_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== fs_context stats ===");
    print(@fs_context_count);
}
