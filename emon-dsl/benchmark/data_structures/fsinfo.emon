// ============================================================
// Benchmark: data_structures - fsinfo
// Tests monitoring filesystem info access
// ============================================================

tool fsinfo_ds {
    option interval = 5s;
}

observe syscall("statfs", "statvfs", "uname")
measure count, retval
{
    @fsinfo_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== fsinfo stats ===");
    print(@fsinfo_count);
}
