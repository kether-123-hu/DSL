// ============================================================
// Benchmark: data_structures - futex
// Tests monitoring futex synchronization operations
// ============================================================

tool futex_ds {
    option interval = 5s;
}

observe syscall("futex", "clone", "semop")
measure count, retval
{
    @futex_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== futex stats ===");
    print(@futex_count);
}
