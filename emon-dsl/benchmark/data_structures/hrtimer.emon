// ============================================================
// Benchmark: data_structures - hrtimer
// Tests monitoring high resolution timer activity
// ============================================================

tool hrtimer_ds {
    option interval = 5s;
}

observe syscall("timer_create", "clock_nanosleep", "nanosleep")
measure count, retval
{
    @hrtimer_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== hrtimer stats ===");
    print(@hrtimer_count);
}
