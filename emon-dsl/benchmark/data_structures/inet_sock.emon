// ============================================================
// Benchmark: data_structures - inet_sock
// Tests monitoring INET socket interactions
// ============================================================

tool inet_sock_ds {
    option interval = 5s;
}

observe syscall("socket", "connect", "getsockname")
measure count, retval
{
    @inet_sock_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== inet_sock stats ===");
    print(@inet_sock_count);
}
