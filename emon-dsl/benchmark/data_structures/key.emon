// ============================================================
// Benchmark: data_structures - key
// Tests monitoring key management operations
// ============================================================

tool key_ds {
    option interval = 5s;
}

observe syscall("add_key", "request_key", "keyctl")
measure count, retval
{
    @key_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== key stats ===");
    print(@key_count);
}
