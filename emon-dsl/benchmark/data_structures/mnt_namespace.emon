// ============================================================
// Benchmark: data_structures - mnt_namespace
// Tests monitoring mount namespace operations
// ============================================================

tool mnt_namespace_ds {
    option interval = 5s;
}

observe syscall("mount", "umount2", "pivot_root")
measure count, retval
{
    @mnt_namespace_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== mnt_namespace stats ===");
    print(@mnt_namespace_count);
}
