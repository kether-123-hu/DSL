// ============================================================
// Benchmark: data_structures - mutex
// Tests monitoring mutex-like operations
// ============================================================

tool mutex_ds {
    option interval = 5s;
}

observe syscall("futex", "clone", "nanosleep")
measure count, retval
{
    @mutex_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== mutex stats ===");
    print(@mutex_count);
}
