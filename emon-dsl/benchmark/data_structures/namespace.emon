// ============================================================
// Benchmark: data_structures - namespace
// Tests monitoring namespace operations via unshare/clone
// ============================================================

tool namespace_ds {
    option interval = 5s;
}

observe syscall("unshare", "setns", "clone")
measure count, retval
{
    @ns_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== namespace (unshare/setns) stats ===");
    print(@ns_count);
}
