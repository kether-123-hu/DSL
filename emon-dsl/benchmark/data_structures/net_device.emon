// ============================================================
// Benchmark: data_structures - net_device
// Tests monitoring network device traffic operations
// ============================================================

tool net_device_ds {
    option interval = 5s;
}

observe syscall("socket", "ioctl", "sendto")
measure count, retval
{
    @net_device_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== net_device stats ===");
    print(@net_device_count);
}
