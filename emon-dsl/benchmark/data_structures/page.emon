// ============================================================
// Benchmark: data_structures - page
// Tests monitoring page mapping operations
// ============================================================

tool page_ds {
    option interval = 5s;
}

observe syscall("mmap", "munmap", "msync")
measure count, retval
{
    @page_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== page stats ===");
    print(@page_count);
}
