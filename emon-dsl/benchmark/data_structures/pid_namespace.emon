// ============================================================
// Benchmark: data_structures - pid_namespace
// Tests monitoring PID namespace operations
// ============================================================

tool pid_namespace_ds {
    option interval = 5s;
}

observe syscall("clone", "unshare", "setns")
measure count, retval
{
    @pid_namespace_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== pid_namespace stats ===");
    print(@pid_namespace_count);
}
