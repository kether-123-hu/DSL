// ============================================================
// Benchmark: data_structures - priority
// Tests monitoring process priority via getpriority/setpriority
// ============================================================

tool priority_ds {
    option interval = 5s;
}

observe syscall("getpriority", "setpriority", "nice")
measure count, retval
{
    @prio_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== priority stats ===");
    print(@prio_count);
}
