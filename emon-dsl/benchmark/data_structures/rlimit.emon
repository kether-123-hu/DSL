// ============================================================
// Benchmark: data_structures - rlimit
// Tests monitoring resource limits via getrlimit/setrlimit
// ============================================================

tool rlimit_ds {
    option interval = 5s;
}

observe syscall("getrlimit", "setrlimit", "prlimit64")
measure count, retval
{
    @rlimit_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== rlimit (resource limits) stats ===");
    print(@rlimit_count);
}
