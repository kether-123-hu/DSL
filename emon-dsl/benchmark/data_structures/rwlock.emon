// ============================================================
// Benchmark: data_structures - rwlock
// Tests monitoring read/write lock activity
// ============================================================

tool rwlock_ds {
    option interval = 5s;
}

observe syscall("fcntl", "clone", "getpid")
measure count, retval
{
    @rwlock_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== rwlock stats ===");
    print(@rwlock_count);
}
