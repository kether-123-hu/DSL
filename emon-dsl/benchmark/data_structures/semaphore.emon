// ============================================================
// Benchmark: data_structures - semaphore
// Tests monitoring semaphore control operations
// ============================================================

tool semaphore_ds {
    option interval = 5s;
}

observe syscall("semget", "semctl", "semop")
measure count, retval
{
    @semaphore_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== semaphore stats ===");
    print(@semaphore_count);
}
