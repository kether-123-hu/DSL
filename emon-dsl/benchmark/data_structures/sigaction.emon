// ============================================================
// Benchmark: data_structures - sigaction
// Tests monitoring signal handlers via sigaction syscall
// ============================================================

tool sigaction_ds {
    option interval = 5s;
}

observe syscall("sigaction", "rt_sigaction", "signal", "rt_sigprocmask")
measure count, retval
{
    @sig_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== sigaction (signal handling) stats ===");
    print(@sig_count);
}
