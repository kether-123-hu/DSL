// ============================================================
// Benchmark: data_structures - signal_struct
// Tests monitoring signal handler operations
// ============================================================

tool signal_struct_ds {
    option interval = 5s;
}

observe syscall("sigaction", "rt_sigaction", "kill")
measure count, retval
{
    @signal_struct_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== signal_struct stats ===");
    print(@signal_struct_count);
}
