// ============================================================
// Benchmark: data_structures - sock
// Tests monitoring generic socket lifecycle
// ============================================================

tool sock_ds {
    option interval = 5s;
}

observe syscall("socket", "bind", "listen")
measure count, retval
{
    @sock_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== sock stats ===");
    print(@sock_count);
}
