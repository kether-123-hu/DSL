// ============================================================
// Benchmark: data_structures - udp_sock
// Tests monitoring UDP socket traffic
// ============================================================

tool udp_sock_ds {
    option interval = 5s;
}

observe syscall("socket", "sendto", "recvfrom")
measure count, retval
{
    @udp_sock_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== udp_sock stats ===");
    print(@udp_sock_count);
}
