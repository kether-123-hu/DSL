// ============================================================
// Benchmark: data_structures - usb_device
// Tests monitoring USB device interaction
// ============================================================

tool usb_device_ds {
    option interval = 5s;
}

observe syscall("open", "ioctl", "read")
measure count, retval
{
    @usb_device_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== usb_device stats ===");
    print(@usb_device_count);
}
