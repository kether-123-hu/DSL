// ============================================================
// Benchmark: data_structures - uts_namespace
// Tests monitoring UTS namespace changes
// ============================================================

tool uts_namespace_ds {
    option interval = 5s;
}

observe syscall("uname", "sethostname", "setdomainname")
measure count, retval
{
    @uts_namespace_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== uts_namespace stats ===");
    print(@uts_namespace_count);
}
