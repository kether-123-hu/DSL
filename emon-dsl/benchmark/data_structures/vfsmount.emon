// ============================================================
// Benchmark: data_structures - vfsmount
// Tests monitoring VFS mount operations
// ============================================================

tool vfsmount_ds {
    option interval = 5s;
}

observe syscall("mount", "umount2", "pivot_root")
measure count, retval
{
    @vfsmount_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== vfsmount stats ===");
    print(@vfsmount_count);
}
