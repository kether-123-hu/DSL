// ============================================================
// Benchmark: data_structures - vm_fault
// Tests monitoring virtual memory fault handling
// ============================================================

tool vm_fault_ds {
    option interval = 5s;
}

observe syscall("mincore", "madvise", "mlock")
measure count, retval
{
    @vm_fault_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== vm_fault stats ===");
    print(@vm_fault_count);
}
