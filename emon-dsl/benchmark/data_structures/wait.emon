// ============================================================
// Benchmark: data_structures - wait
// Tests monitoring wait family syscalls (process wait)
// ============================================================

tool wait_ds {
    option interval = 5s;
}

observe syscall("wait4", "waitpid", "waitid")
measure latency, retval
{
    @wait_count[comm, syscall] = count();
    @wait_avg[comm, syscall]  = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== wait (process wait) stats ===");
    print(@wait_count);
    print(@wait_avg);
}
