// ============================================================
// Benchmark: data_structures - workqueue
// Tests monitoring workqueue scheduling and I/O
// ============================================================

tool workqueue_ds {
    option interval = 5s;
}

observe syscall("eventfd", "io_submit", "io_getevents")
measure count, retval
{
    @workqueue_count[comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== workqueue stats ===");
    print(@workqueue_count);
}
