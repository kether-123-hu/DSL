tool bench_event_ringbuf {
    option target_pid = 0;
}

observe syscall("openat")
where target_pid == 0 || pid == target_pid
measure latency, retval
{
    @open_count[comm, pid] = count();
    emit {
        time = nsecs;
        comm = comm;
        pid = pid;
        tid = tid;
        syscall = syscall;
        latency = latency;
        retval = retval;
    };
}
