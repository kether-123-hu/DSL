// ============================================================
// Benchmark: events - block_bio
// Tests block device I/O event monitoring
// ============================================================

tool block_bio_event {
    option interval = 5s;
}

observe tracepoint("block:block_bio_queue", "block:block_bio_backmerge")
measure count
{
    @bio_count[cpu] = count();

    emit {
        time = nsecs;
        cpu  = cpu;
    };
}

every interval {
    print("=== block bio events ===");
    print(@bio_count);
}
