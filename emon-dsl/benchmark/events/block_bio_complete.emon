// ============================================================
// Benchmark: events - block_bio_complete
// Tests block bio complete event monitoring
// ============================================================

tool block_bio_complete_event {
    option interval = 5s;
}

    observe tracepoint("block:block_bio_complete")
measure count, latency
{
    @block_bio_complete_count[pid, comm] = count();
    @block_bio_complete_avg[pid, comm]   = avg(latency);
    @block_bio_complete_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== block bio complete events ===");
    print(@block_bio_complete_count);
    print(@block_bio_complete_avg);
    print(@block_bio_complete_hist);
}
