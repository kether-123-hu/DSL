// ============================================================
// Benchmark: events - block_bio_frontmerge
// Tests block bio frontmerge event monitoring
// ============================================================

tool block_bio_frontmerge_event {
    option interval = 5s;
}

    observe tracepoint("block:block_bio_frontmerge")
measure count, latency
{
    @block_bio_frontmerge_count[pid, comm] = count();
    @block_bio_frontmerge_avg[pid, comm]   = avg(latency);
    @block_bio_frontmerge_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== block bio frontmerge events ===");
    print(@block_bio_frontmerge_count);
    print(@block_bio_frontmerge_avg);
    print(@block_bio_frontmerge_hist);
}
