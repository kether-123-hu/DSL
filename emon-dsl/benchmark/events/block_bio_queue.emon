// ============================================================
// Benchmark: events - block_bio_queue
// Tests block bio queue event monitoring
// ============================================================

tool block_bio_queue_event {
    option interval = 5s;
}

    observe tracepoint("block:block_bio_queue")
measure count, latency
{
    @block_bio_queue_count[pid, comm] = count();
    @block_bio_queue_avg[pid, comm]   = avg(latency);
    @block_bio_queue_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== block bio queue events ===");
    print(@block_bio_queue_count);
    print(@block_bio_queue_avg);
    print(@block_bio_queue_hist);
}
