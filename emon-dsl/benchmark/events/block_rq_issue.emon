// ============================================================
// Benchmark: events - block_rq_issue
// Tests block rq issue event monitoring
// ============================================================

tool block_rq_issue_event {
    option interval = 5s;
}

    observe tracepoint("block:block_rq_issue")
measure count, latency
{
    @block_rq_issue_count[pid, comm] = count();
    @block_rq_issue_avg[pid, comm]   = avg(latency);
    @block_rq_issue_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== block rq issue events ===");
    print(@block_rq_issue_count);
    print(@block_rq_issue_avg);
    print(@block_rq_issue_hist);
}
