// ============================================================
// Benchmark: events - ip_forward
// Tests ip forward event monitoring
// ============================================================

tool ip_forward_event {
    option interval = 5s;
}

    observe tracepoint("ip:ip_forward")
measure count, latency
{
    @ip_forward_count[pid, comm] = count();
    @ip_forward_avg[pid, comm]   = avg(latency);
    @ip_forward_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== ip forward events ===");
    print(@ip_forward_count);
    print(@ip_forward_avg);
    print(@ip_forward_hist);
}
