// ============================================================
// Benchmark: events - kprobe_vfs_write
// Tests kprobe vfs write event monitoring
// ============================================================

tool kprobe_vfs_write_event {
    option interval = 5s;
}

    observe kernel("vfs_write")
measure count, latency
{
    @kprobe_vfs_write_count[pid, comm] = count();
    @kprobe_vfs_write_avg[pid, comm]   = avg(latency);
    @kprobe_vfs_write_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== kprobe vfs write events ===");
    print(@kprobe_vfs_write_count);
    print(@kprobe_vfs_write_avg);
    print(@kprobe_vfs_write_hist);
}
