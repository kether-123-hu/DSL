// ============================================================
// Benchmark: events - net_udp_sendmsg
// Tests net udp sendmsg event monitoring
// ============================================================

tool net_udp_sendmsg_event {
    option interval = 5s;
}

    observe net("udp_sendmsg")
measure count, latency
{
    @net_udp_sendmsg_count[pid, comm] = count();
    @net_udp_sendmsg_avg[pid, comm]   = avg(latency);
    @net_udp_sendmsg_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== net udp sendmsg events ===");
    print(@net_udp_sendmsg_count);
    print(@net_udp_sendmsg_avg);
    print(@net_udp_sendmsg_hist);
}
