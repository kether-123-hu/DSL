// ============================================================
// Benchmark: events - sock_bind
// Tests sock bind event monitoring
// ============================================================

tool sock_bind_event {
    option interval = 5s;
}

    observe tracepoint("sock:inet_sock_set_state")
measure count, latency
{
    @sock_bind_count[pid, comm] = count();
    @sock_bind_avg[pid, comm]   = avg(latency);
    @sock_bind_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== sock bind events ===");
    print(@sock_bind_count);
    print(@sock_bind_avg);
    print(@sock_bind_hist);
}
