// ============================================================
// Benchmark: functions - __kmem_cache_alloc
// Tests kernel function kprobe for   kmem cache alloc
// ============================================================

tool __kmem_cache_alloc_func {
    option interval = 5s;
}

observe kernel("__kmem_cache_alloc")
measure latency
{
    @__kmem_cache_alloc_count[pid, comm] = count();
    @__kmem_cache_alloc_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== __kmem_cache_alloc kernel function ===");
    print(@__kmem_cache_alloc_count);
    print(@__kmem_cache_alloc_avg);
}
