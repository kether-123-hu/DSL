// ============================================================
// Benchmark: functions - alloc_pages_exact
// Tests kernel function kprobe for alloc pages exact
// ============================================================

tool alloc_pages_exact_func {
    option interval = 5s;
}

observe kernel("alloc_pages_exact")
measure latency
{
    @alloc_pages_exact_count[pid, comm] = count();
    @alloc_pages_exact_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== alloc_pages_exact kernel function ===");
    print(@alloc_pages_exact_count);
    print(@alloc_pages_exact_avg);
}
