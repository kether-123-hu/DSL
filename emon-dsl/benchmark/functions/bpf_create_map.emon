// ============================================================
// Benchmark: functions - bpf_create_map
// Tests kernel function kprobe for bpf create map
// ============================================================

tool bpf_create_map_func {
    option interval = 5s;
}

observe kernel("bpf_create_map")
measure latency
{
    @bpf_create_map_count[pid, comm] = count();
    @bpf_create_map_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== bpf_create_map kernel function ===");
    print(@bpf_create_map_count);
    print(@bpf_create_map_avg);
}
