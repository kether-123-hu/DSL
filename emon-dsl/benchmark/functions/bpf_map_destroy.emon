// ============================================================
// Benchmark: functions - bpf_map_destroy
// Tests kernel function kprobe for bpf map destroy
// ============================================================

tool bpf_map_destroy_func {
    option interval = 5s;
}

observe kernel("bpf_map_destroy")
measure latency
{
    @bpf_map_destroy_count[pid, comm] = count();
    @bpf_map_destroy_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== bpf_map_destroy kernel function ===");
    print(@bpf_map_destroy_count);
    print(@bpf_map_destroy_avg);
}
