// ============================================================
// Benchmark: functions - bpf_prog_run
// Tests kernel function kprobe for bpf prog run
// ============================================================

tool bpf_prog_run_func {
    option interval = 5s;
}

observe kernel("bpf_prog_run")
measure latency
{
    @bpf_prog_run_count[pid, comm] = count();
    @bpf_prog_run_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== bpf_prog_run kernel function ===");
    print(@bpf_prog_run_count);
    print(@bpf_prog_run_avg);
}
