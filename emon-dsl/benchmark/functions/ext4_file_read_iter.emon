// ============================================================
// Benchmark: functions - ext4_file_read_iter
// Tests kernel function kprobe for ext4 file read iter
// ============================================================

tool ext4_file_read_iter_func {
    option interval = 5s;
}

observe kernel("ext4_file_read_iter")
measure latency
{
    @ext4_file_read_iter_count[pid, comm] = count();
    @ext4_file_read_iter_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== ext4_file_read_iter kernel function ===");
    print(@ext4_file_read_iter_count);
    print(@ext4_file_read_iter_avg);
}
