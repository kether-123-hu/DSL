// ============================================================
// Benchmark: functions - filemap_write_and_wait
// Tests kernel function kprobe for filemap write and wait
// ============================================================

tool filemap_write_and_wait_func {
    option interval = 5s;
}

observe kernel("filemap_write_and_wait")
measure latency
{
    @filemap_write_and_wait_count[pid, comm] = count();
    @filemap_write_and_wait_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== filemap_write_and_wait kernel function ===");
    print(@filemap_write_and_wait_count);
    print(@filemap_write_and_wait_avg);
}
