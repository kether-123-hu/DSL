// ============================================================
// Benchmark: functions - generic_file_read_iter
// Tests kernel function kprobe for generic file read iter
// ============================================================

tool generic_file_read_iter_func {
    option interval = 5s;
}

observe kernel("generic_file_read_iter")
measure latency
{
    @generic_file_read_iter_count[pid, comm] = count();
    @generic_file_read_iter_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== generic_file_read_iter kernel function ===");
    print(@generic_file_read_iter_count);
    print(@generic_file_read_iter_avg);
}
