// ============================================================
// Benchmark: functions - ip_output
// Tests kernel function kprobe for IP packet output
// ============================================================

tool ip_output_func {
    option interval = 5s;
}

observe kernel("ip_output", "ip_finish_output", "__ip_finish_output", "ip_local_out")
measure latency
{
    @ip_count[func, pid, comm] = count();
    @ip_avg[func, pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        func    = func;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== ip_output kernel functions ===");
    print(@ip_count);
    print(@ip_avg);
}
