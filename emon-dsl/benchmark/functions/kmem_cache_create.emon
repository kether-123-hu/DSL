// ============================================================
// Benchmark: functions - kmem_cache_create
// Tests kernel function kprobe for kmem cache create
// ============================================================

tool kmem_cache_create_func {
    option interval = 5s;
}

observe kernel("kmem_cache_create")
measure latency
{
    @kmem_cache_create_count[pid, comm] = count();
    @kmem_cache_create_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== kmem_cache_create kernel function ===");
    print(@kmem_cache_create_count);
    print(@kmem_cache_create_avg);
}
