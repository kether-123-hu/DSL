// ============================================================
// Benchmark: functions - kmem_cache_destroy
// Tests kernel function kprobe for kmem cache destroy
// ============================================================

tool kmem_cache_destroy_func {
    option interval = 5s;
}

observe kernel("kmem_cache_destroy")
measure latency
{
    @kmem_cache_destroy_count[pid, comm] = count();
    @kmem_cache_destroy_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== kmem_cache_destroy kernel function ===");
    print(@kmem_cache_destroy_count);
    print(@kmem_cache_destroy_avg);
}
