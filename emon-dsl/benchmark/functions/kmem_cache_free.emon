// ============================================================
// Benchmark: functions - kmem_cache_free
// Tests kernel function kprobe for kmem cache free
// ============================================================

tool kmem_cache_free_func {
    option interval = 5s;
}

observe kernel("kmem_cache_free")
measure latency
{
    @kmem_cache_free_count[pid, comm] = count();
    @kmem_cache_free_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== kmem_cache_free kernel function ===");
    print(@kmem_cache_free_count);
    print(@kmem_cache_free_avg);
}
