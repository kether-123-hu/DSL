// ============================================================
// Benchmark: functions - page_cache_sync
// Tests kernel function kprobe for page cache sync
// ============================================================

tool page_cache_sync_func {
    option interval = 5s;
}

observe kernel("page_cache_sync")
measure latency
{
    @page_cache_sync_count[pid, comm] = count();
    @page_cache_sync_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== page_cache_sync kernel function ===");
    print(@page_cache_sync_count);
    print(@page_cache_sync_avg);
}
