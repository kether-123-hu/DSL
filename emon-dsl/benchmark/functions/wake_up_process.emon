// ============================================================
// Benchmark: functions - wake_up_process
// Tests kernel function kprobe for wake up process
// ============================================================

tool wake_up_process_func {
    option interval = 5s;
}

observe kernel("wake_up_process")
measure latency
{
    @wake_up_process_count[pid, comm] = count();
    @wake_up_process_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== wake_up_process kernel function ===");
    print(@wake_up_process_count);
    print(@wake_up_process_avg);
}
