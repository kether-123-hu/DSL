// ============================================================
// Benchmark: kprobe - bio_end_io
// Tests kernel kprobe for function bio_end_io
// ============================================================

tool bio_end_io_kp {
    option interval = 5s;
}

observe kernel("bio_end_io")
measure latency
{
    @bio_end_io_count[pid, comm] = count();
    @bio_end_io_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== bio_end_io kprobe ===");
    print(@bio_end_io_count);
    print(@bio_end_io_avg);
}
