// ============================================================
// Benchmark: kprobe - blk_mq_queue_rq
// Tests kernel kprobe for function blk_mq_queue_rq
// ============================================================

tool blk_mq_queue_rq_kp {
    option interval = 5s;
}

observe kernel("blk_mq_queue_rq")
measure latency
{
    @blk_mq_queue_rq_count[pid, comm] = count();
    @blk_mq_queue_rq_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== blk_mq_queue_rq kprobe ===");
    print(@blk_mq_queue_rq_count);
    print(@blk_mq_queue_rq_avg);
}
