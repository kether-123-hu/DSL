// ============================================================
// Benchmark: kprobe - blk_queue_bio
// Tests kernel kprobe for function blk_queue_bio
// ============================================================

tool blk_queue_bio_kp {
    option interval = 5s;
}

observe kernel("blk_queue_bio")
measure latency
{
    @blk_queue_bio_count[pid, comm] = count();
    @blk_queue_bio_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== blk_queue_bio kprobe ===");
    print(@blk_queue_bio_count);
    print(@blk_queue_bio_avg);
}
