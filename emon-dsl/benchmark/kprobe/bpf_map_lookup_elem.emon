// ============================================================
// Benchmark: kprobe - bpf_map_lookup_elem
// Tests kernel kprobe for function bpf_map_lookup_elem
// ============================================================

tool bpf_map_lookup_elem_kp {
    option interval = 5s;
}

observe kernel("bpf_map_lookup_elem")
measure latency
{
    @bpf_map_lookup_elem_count[pid, comm] = count();
    @bpf_map_lookup_elem_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== bpf_map_lookup_elem kprobe ===");
    print(@bpf_map_lookup_elem_count);
    print(@bpf_map_lookup_elem_avg);
}
