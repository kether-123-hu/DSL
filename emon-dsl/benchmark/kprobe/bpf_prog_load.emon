// ============================================================
// Benchmark: kprobe - bpf_prog_load
// Tests kernel kprobe for function bpf_prog_load
// ============================================================

tool bpf_prog_load_kp {
    option interval = 5s;
}

observe kernel("bpf_prog_load")
measure latency
{
    @bpf_prog_load_count[pid, comm] = count();
    @bpf_prog_load_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== bpf_prog_load kprobe ===");
    print(@bpf_prog_load_count);
    print(@bpf_prog_load_avg);
}
