// ============================================================
// Benchmark: kprobe - dev_queue_xmit
// Tests kernel kprobe for function dev_queue_xmit
// ============================================================

tool dev_queue_xmit_kp {
    option interval = 5s;
}

observe kernel("dev_queue_xmit")
measure latency
{
    @dev_queue_xmit_count[pid, comm] = count();
    @dev_queue_xmit_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== dev_queue_xmit kprobe ===");
    print(@dev_queue_xmit_count);
    print(@dev_queue_xmit_avg);
}
