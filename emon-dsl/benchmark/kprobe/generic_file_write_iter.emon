// ============================================================
// Benchmark: kprobe - generic_file_write_iter
// Tests kernel kprobe for function generic_file_write_iter
// ============================================================

tool generic_file_write_iter_kp {
    option interval = 5s;
}

observe kernel("generic_file_write_iter")
measure latency
{
    @generic_file_write_iter_count[pid, comm] = count();
    @generic_file_write_iter_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== generic_file_write_iter kprobe ===");
    print(@generic_file_write_iter_count);
    print(@generic_file_write_iter_avg);
}
