// ============================================================
// Benchmark: kprobe - ip_output
// Tests kernel kprobe for function ip_output
// ============================================================

tool ip_output_kp {
    option interval = 5s;
}

observe kernel("ip_output")
measure latency
{
    @ip_output_count[pid, comm] = count();
    @ip_output_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== ip_output kprobe ===");
    print(@ip_output_count);
    print(@ip_output_avg);
}
