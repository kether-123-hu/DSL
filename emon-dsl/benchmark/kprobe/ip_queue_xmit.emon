// ============================================================
// Benchmark: kprobe - ip_queue_xmit
// Tests kernel kprobe for function ip_queue_xmit
// ============================================================

tool ip_queue_xmit_kp {
    option interval = 5s;
}

observe kernel("ip_queue_xmit")
measure latency
{
    @ip_queue_xmit_count[pid, comm] = count();
    @ip_queue_xmit_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== ip_queue_xmit kprobe ===");
    print(@ip_queue_xmit_count);
    print(@ip_queue_xmit_avg);
}
