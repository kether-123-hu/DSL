// ============================================================
// Benchmark: kprobe - schedule_timeout
// Tests kernel kprobe for function schedule_timeout
// ============================================================

tool schedule_timeout_kp {
    option interval = 5s;
}

observe kernel("schedule_timeout")
measure latency
{
    @schedule_timeout_count[pid, comm] = count();
    @schedule_timeout_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== schedule_timeout kprobe ===");
    print(@schedule_timeout_count);
    print(@schedule_timeout_avg);
}
