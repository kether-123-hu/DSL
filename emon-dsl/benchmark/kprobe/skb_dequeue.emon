// ============================================================
// Benchmark: kprobe - skb_dequeue
// Tests kernel kprobe for function skb_dequeue
// ============================================================

tool skb_dequeue_kp {
    option interval = 5s;
}

observe kernel("skb_dequeue")
measure latency
{
    @skb_dequeue_count[pid, comm] = count();
    @skb_dequeue_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== skb_dequeue kprobe ===");
    print(@skb_dequeue_count);
    print(@skb_dequeue_avg);
}
