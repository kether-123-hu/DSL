// ============================================================
// Benchmark: kprobe - tcp_recvmsg
// Tests kernel kprobe for function tcp_recvmsg
// ============================================================

tool tcp_recvmsg_kp {
    option interval = 5s;
}

observe kernel("tcp_recvmsg")
measure latency
{
    @tcp_recvmsg_count[pid, comm] = count();
    @tcp_recvmsg_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== tcp_recvmsg kprobe ===");
    print(@tcp_recvmsg_count);
    print(@tcp_recvmsg_avg);
}
