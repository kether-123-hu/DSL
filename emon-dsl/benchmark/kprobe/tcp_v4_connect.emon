// ============================================================
// Benchmark: kprobe - tcp_v4_connect
// Tests kernel kprobe for function tcp_v4_connect
// ============================================================

tool tcp_v4_connect_kp {
    option interval = 5s;
}

observe kernel("tcp_v4_connect")
measure latency
{
    @tcp_v4_connect_count[pid, comm] = count();
    @tcp_v4_connect_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

every interval {
    print("=== tcp_v4_connect kprobe ===");
    print(@tcp_v4_connect_count);
    print(@tcp_v4_connect_avg);
}
