tool bench_syscall_latency {
    option target_pid = 0;
    option min_latency = 1us;
    option top = 10;
}

observe syscall("read", "write", "openat")
where target_pid == 0 || pid == target_pid
measure latency, retval
when latency > min_latency
{
    @lat_count[comm, pid, syscall] = count();
    @lat_avg[comm, pid, syscall] = avg(latency);
    @lat_hist[comm, pid, syscall] = hist(latency);
}

every 1s {
    print(top(@lat_count, top));
    print(@lat_avg);
    print(@lat_hist);
}
