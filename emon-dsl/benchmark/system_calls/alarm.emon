// ============================================================
// Benchmark: system_calls - alarm
// Tests alarm syscall monitoring with latency and return value tracking
// ============================================================

tool alarm_syscall {
    option interval = 5s;
}

observe syscall("alarm")
measure latency, retval
{
    @alarm_count[pid, comm] = count();
    @alarm_avg[pid, comm]   = avg(latency);
    @alarm_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== alarm syscall stats ===");
    print(@alarm_count);
    print(@alarm_avg);
    print(@alarm_hist);
}
