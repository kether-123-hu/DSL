// ============================================================
// Benchmark: system_calls - brk
// Tests brk syscall monitoring with latency and return value tracking
// ============================================================

tool brk_syscall {
    option interval = 5s;
}

observe syscall("brk")
measure latency, retval
{
    @brk_count[pid, comm] = count();
    @brk_avg[pid, comm]   = avg(latency);
    @brk_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== brk syscall stats ===");
    print(@brk_count);
    print(@brk_avg);
    print(@brk_hist);
}
