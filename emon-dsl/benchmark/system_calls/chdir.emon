// ============================================================
// Benchmark: system_calls - chdir
// Tests chdir syscall monitoring with latency and return value tracking
// ============================================================

tool chdir_syscall {
    option interval = 5s;
}

observe syscall("chdir")
measure latency, retval
{
    @chdir_count[pid, comm] = count();
    @chdir_avg[pid, comm]   = avg(latency);
    @chdir_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== chdir syscall stats ===");
    print(@chdir_count);
    print(@chdir_avg);
    print(@chdir_hist);
}
