// ============================================================
// Benchmark: system_calls - chroot
// Tests chroot syscall monitoring with latency and return value tracking
// ============================================================

tool chroot_syscall {
    option interval = 5s;
}

observe syscall("chroot")
measure latency, retval
{
    @chroot_count[pid, comm] = count();
    @chroot_avg[pid, comm]   = avg(latency);
    @chroot_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== chroot syscall stats ===");
    print(@chroot_count);
    print(@chroot_avg);
    print(@chroot_hist);
}
