// ============================================================
// Benchmark: system_calls - creat
// Tests creat syscall monitoring with latency and return value tracking
// ============================================================

tool creat_syscall {
    option interval = 5s;
}

observe syscall("creat")
measure latency, retval
{
    @creat_count[pid, comm] = count();
    @creat_avg[pid, comm]   = avg(latency);
    @creat_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== creat syscall stats ===");
    print(@creat_count);
    print(@creat_avg);
    print(@creat_hist);
}
