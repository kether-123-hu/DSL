// ============================================================
// Benchmark: system_calls - dup
// Tests dup syscall monitoring with latency and return value tracking
// ============================================================

tool dup_syscall {
    option interval = 5s;
}

observe syscall("dup")
measure latency, retval
{
    @dup_count[pid, comm] = count();
    @dup_avg[pid, comm]   = avg(latency);
    @dup_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== dup syscall stats ===");
    print(@dup_count);
    print(@dup_avg);
    print(@dup_hist);
}
