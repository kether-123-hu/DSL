// ============================================================
// Benchmark: system_calls - dup3
// Tests dup3 syscall monitoring with latency and return value tracking
// ============================================================

tool dup3_syscall {
    option interval = 5s;
}

observe syscall("dup3")
measure latency, retval
{
    @dup3_count[pid, comm] = count();
    @dup3_avg[pid, comm]   = avg(latency);
    @dup3_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== dup3 syscall stats ===");
    print(@dup3_count);
    print(@dup3_avg);
    print(@dup3_hist);
}
