// ============================================================
// Benchmark: system_calls - epoll_wait
// Tests epoll_wait syscall monitoring with latency and return value tracking
// ============================================================

tool epoll_wait_syscall {
    option interval = 5s;
}

observe syscall("epoll_wait")
measure latency, retval
{
    @epoll_wait_count[pid, comm] = count();
    @epoll_wait_avg[pid, comm]   = avg(latency);
    @epoll_wait_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== epoll wait syscall stats ===");
    print(@epoll_wait_count);
    print(@epoll_wait_avg);
    print(@epoll_wait_hist);
}
