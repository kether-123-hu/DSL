// ============================================================
// Benchmark: system_calls - execve
// Tests execve syscall monitoring for process execution
// ============================================================

tool execve_syscall {
    option interval = 5s;
}

observe syscall("execve", "execveat")
measure latency, retval
{
    @execve_count[pid, comm] = count();
    @execve_avg[pid, comm]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== execve syscall stats ===");
    print(@execve_count);
    print(@execve_avg);
}
