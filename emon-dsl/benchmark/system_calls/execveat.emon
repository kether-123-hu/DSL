// ============================================================
// Benchmark: system_calls - execveat
// Tests execveat syscall monitoring with latency and return value tracking
// ============================================================

tool execveat_syscall {
    option interval = 5s;
}

observe syscall("execveat")
measure latency, retval
{
    @execveat_count[pid, comm] = count();
    @execveat_avg[pid, comm]   = avg(latency);
    @execveat_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== execveat syscall stats ===");
    print(@execveat_count);
    print(@execveat_avg);
    print(@execveat_hist);
}
