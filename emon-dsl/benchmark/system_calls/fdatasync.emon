// ============================================================
// Benchmark: system_calls - fdatasync
// Tests fdatasync syscall monitoring with latency and return value tracking
// ============================================================

tool fdatasync_syscall {
    option interval = 5s;
}

observe syscall("fdatasync")
measure latency, retval
{
    @fdatasync_count[pid, comm] = count();
    @fdatasync_avg[pid, comm]   = avg(latency);
    @fdatasync_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== fdatasync syscall stats ===");
    print(@fdatasync_count);
    print(@fdatasync_avg);
    print(@fdatasync_hist);
}
