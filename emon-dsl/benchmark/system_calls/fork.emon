// ============================================================
// Benchmark: system_calls - fork
// Tests fork syscall monitoring with latency and return value tracking
// ============================================================

tool fork_syscall {
    option interval = 5s;
}

observe syscall("fork")
measure latency, retval
{
    @fork_count[pid, comm] = count();
    @fork_avg[pid, comm]   = avg(latency);
    @fork_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== fork syscall stats ===");
    print(@fork_count);
    print(@fork_avg);
    print(@fork_hist);
}
