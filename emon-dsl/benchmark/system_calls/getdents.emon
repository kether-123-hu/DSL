// ============================================================
// Benchmark: system_calls - getdents
// Tests getdents syscall monitoring with latency and return value tracking
// ============================================================

tool getdents_syscall {
    option interval = 5s;
}

observe syscall("getdents")
measure latency, retval
{
    @getdents_count[pid, comm] = count();
    @getdents_avg[pid, comm]   = avg(latency);
    @getdents_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== getdents syscall stats ===");
    print(@getdents_count);
    print(@getdents_avg);
    print(@getdents_hist);
}
