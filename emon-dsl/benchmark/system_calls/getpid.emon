// ============================================================
// Benchmark: system_calls - getpid
// Tests getpid syscall monitoring with latency and return value tracking
// ============================================================

tool getpid_syscall {
    option interval = 5s;
}

observe syscall("getpid")
measure latency, retval
{
    @getpid_count[pid, comm] = count();
    @getpid_avg[pid, comm]   = avg(latency);
    @getpid_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== getpid syscall stats ===");
    print(@getpid_count);
    print(@getpid_avg);
    print(@getpid_hist);
}
