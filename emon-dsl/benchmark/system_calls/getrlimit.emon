// ============================================================
// Benchmark: system_calls - getrlimit
// Tests getrlimit syscall monitoring with latency and return value tracking
// ============================================================

tool getrlimit_syscall {
    option interval = 5s;
}

observe syscall("getrlimit")
measure latency, retval
{
    @getrlimit_count[pid, comm] = count();
    @getrlimit_avg[pid, comm]   = avg(latency);
    @getrlimit_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== getrlimit syscall stats ===");
    print(@getrlimit_count);
    print(@getrlimit_avg);
    print(@getrlimit_hist);
}
