// ============================================================
// Benchmark: system_calls - getrusage
// Tests getrusage syscall monitoring with latency and return value tracking
// ============================================================

tool getrusage_syscall {
    option interval = 5s;
}

observe syscall("getrusage")
measure latency, retval
{
    @getrusage_count[pid, comm] = count();
    @getrusage_avg[pid, comm]   = avg(latency);
    @getrusage_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== getrusage syscall stats ===");
    print(@getrusage_count);
    print(@getrusage_avg);
    print(@getrusage_hist);
}
