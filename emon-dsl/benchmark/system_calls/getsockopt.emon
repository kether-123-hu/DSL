// ============================================================
// Benchmark: system_calls - getsockopt
// Tests getsockopt syscall monitoring with latency and return value tracking
// ============================================================

tool getsockopt_syscall {
    option interval = 5s;
}

observe syscall("getsockopt")
measure latency, retval
{
    @getsockopt_count[pid, comm] = count();
    @getsockopt_avg[pid, comm]   = avg(latency);
    @getsockopt_hist[pid, comm]  = hist(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== getsockopt syscall stats ===");
    print(@getsockopt_count);
    print(@getsockopt_avg);
    print(@getsockopt_hist);
}
