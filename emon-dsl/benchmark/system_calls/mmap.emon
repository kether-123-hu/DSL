// ============================================================
// Benchmark: system_calls - mmap
// Tests mmap syscall monitoring for memory mapping operations
// ============================================================

tool mmap_syscall {
    option interval = 5s;
}

observe syscall("mmap", "munmap")
measure latency, retval
{
    @mmap_count[pid, comm, syscall] = count();
    @mmap_avg[pid, comm, syscall]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== mmap syscall stats ===");
    print(@mmap_count);
    print(@mmap_avg);
}
