// ============================================================
// Benchmark: system_calls - poll
// Tests poll/epoll syscalls monitoring
// ============================================================

tool poll_syscall {
    option interval = 5s;
}

observe syscall("poll", "ppoll", "epoll_wait", "epoll_ctl")
measure latency, retval
{
    @poll_count[pid, comm, syscall] = count();
    @poll_avg[pid, comm, syscall]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== poll/epoll syscall stats ===");
    print(@poll_count);
    print(@poll_avg);
}
