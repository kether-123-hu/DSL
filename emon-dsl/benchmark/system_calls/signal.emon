// ============================================================
// Benchmark: system_calls - signal
// Tests signal-related syscalls monitoring
// ============================================================

tool signal_syscall {
    option interval = 5s;
}

observe syscall("kill", "tkill", "tgkill", "sigaction")
measure count, retval
{
    @signal_count[pid, comm, syscall] = count();

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        retval  = retval;
    };
}

every interval {
    print("=== signal-related syscall stats ===");
    print(@signal_count);
}
