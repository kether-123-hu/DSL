// ============================================================
// Benchmark: system_calls - socket
// Tests socket-related syscalls monitoring
// ============================================================

tool socket_syscall {
    option interval = 5s;
}

observe syscall("socket", "connect", "accept", "bind", "listen")
measure latency, retval
{
    @socket_count[pid, comm, syscall] = count();
    @socket_avg[pid, comm, syscall]   = avg(latency);

    emit {
        time    = nsecs;
        pid     = pid;
        comm    = comm;
        syscall = syscall;
        latency = latency;
        retval  = retval;
    };
}

every interval {
    print("=== socket-related syscall stats ===");
    print(@socket_count);
    print(@socket_avg);
}
