// ============================================================
// Emon DSL Example: File System Events
// Monitors file I/O via syscall tracepoints.
//
// ============================================================

tool file_monitor {
    option interval = 3s;
}

observe syscall("read", "write", "openat", "close")
measure latency
{
    @f_count[syscall, comm]   = count();
    @f_avg[syscall, comm]     = avg(latency);

}

every interval {
    print("==== file operations summary ====");
    print(@f_count);
    print(@f_avg);
}
