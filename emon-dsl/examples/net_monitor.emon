// ============================================================
// Emon DSL Example: Network Events
// Monitors network-related kernel functions.
// ============================================================

tool net_monitor {
    option top_n = 5;
}

observe net("tcp_sendmsg", "tcp_recvmsg", "udp_sendmsg")
measure latency
{
    @net_count[comm, pid]  = count();
    @net_avg[comm]         = avg(latency);

    emit {
        time    = nsecs;
        func    = func;
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

end {
    print(top(@net_count, top_n));   // 退出时只打印 top 5
    print(top(@net_avg, top_n));
}