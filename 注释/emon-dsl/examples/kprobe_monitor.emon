// ===================================================================
// kprobe_monitor.emon —— 内核函数监控示例
// ===================================================================
//
// 【这个示例做什么？】
// 使用 kprobe 挂载到三个 TCP 相关的内核函数，监控它们的调用延迟。
// 每隔 2 秒打印一次统计结果。
//
// 【observe kernel 的含义】
// kernel("func1", "func2") 使用 Linux kprobe 机制，
// 在内核函数的入口和出口处插入探针。
// 这与 observe syscall 不同，syscall 使用的是 tracepoint。
//
// 【演示的语法特性】
//   - observe kernel（kprobe 动态探针）
//   - every 周期性任务
//   - print(@agg) 打印聚合结果
//   - top() 函数取前 N 名
// ===================================================================

tool kprobe_monitor {
    option interval = 2s;    // 每 2 秒输出一次统计
    option top_n     = 10;   // 每次显示前 10 条
}

// 监控 TCP 连接相关的三个内核函数
// tcp_v4_connect: IPv4 TCP 连接建立
// tcp_v6_connect: IPv6 TCP 连接建立
// tcp_close:      TCP 连接关闭
observe kernel("tcp_v4_connect", "tcp_v6_connect", "tcp_close")
measure latency           // 测量这些内核函数的执行延迟
{
    // 按(函数名, 进程ID, 进程名)分组统计
    @k_count[func, pid, comm]    = count();          // 调用次数
    @k_avg[func, pid, comm]      = avg(latency);      // 平均延迟

    // 输出每个事件的详细信息
    emit {
        time    = nsecs;
        func    = func;      // 内核函数名（kernel hook 的上下文变量）
        pid     = pid;
        comm    = comm;
        latency = latency;
    };
}

// every: 每 2 秒（interval option 的值）执行一次
every interval {
    print("==== 内核函数统计 ====");
    // top(@k_count, top_n): 取 @k_count 中 value 最大的前 top_n 条
    print(top(@k_count, top_n));
    print(@k_avg);
}
