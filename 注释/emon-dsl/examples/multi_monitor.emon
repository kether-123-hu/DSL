// ===================================================================
// multi_monitor.emon —— 多类型混合监控示例
// ===================================================================
//
// 【这个示例做什么？】
// 在一个工具中同时监控两种不同类型的事件：
//   1. 系统调用（syscall）
//   2. 调度器事件（sched）
//
// 【演示的概念】
// 一个 Emon 工具可以包含多个 observe 块，
// 每个 observe 块独立配置自己的监控目标和聚合变量。
// 编译器会自动为每个 observe 块生成对应的 BPF 程序。
// ===================================================================

tool multi_monitor {
    option interval = 2s;  // 统一报告间隔
}

// ---- 监控块 1: 系统调用监控 ----
observe syscall("read", "write")
{
    // 按(进程名, 进程ID, 系统调用名)分组计数
    @sys_count[comm, pid, syscall] = count();
}

// ---- 监控块 2: 调度器事件监控 ----
// sched_switch: 进程上下文切换事件
observe sched("sched_switch")
{
    // 按 CPU 编号分组统计调度次数
    // 可以观察每个 CPU 的调度负载分布
    @sched_count[cpu] = count();
}

// ---- 周期性报告 ----
// 每 2 秒打印所有监控块的统计结果
every interval {
    print("==== 多类型监控报告 ====");
    print(@sys_count);     // 系统调用统计
    print(@sched_count);   // 调度器统计
}
